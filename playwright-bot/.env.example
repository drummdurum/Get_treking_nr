# -------------------------------------------------------
# WordPress endpoint
# -------------------------------------------------------

# URL til din WordPress/WooCommerce installation (uden afsluttende /)
WP_BASE_URL=xxxx

# API-nøgle fra WooCommerce > Tracking Bot API
WP_API_KEY=xxxx

KG_TRACKING_API_KEY=xxx

# -------------------------------------------------------
# AO / Ahlsell login
# -------------------------------------------------------

# Login-URL til AO/Ahlsell B2B portal
AO_LOGIN_URL=xxxx

# Din brugerkonto hos AO
AO_USERNAME=xxxxx  
AO_PASSWORD=xxxx

# WordPress admin login (bruges til browser-flow via /mellon)
WP_ADMIN_USERNAME=
WP_ADMIN_PASSWORD=

# Optional: override af login og fulfillment-side
# WP_ADMIN_LOGIN_URL=https://kloakgods.dk/mellon
# WP_FULFILLMENT_URL=https://kloakgods.dk/wp-admin/admin.php?page=fulfillment-dashboard

# -------------------------------------------------------
# Bot-opførsel
# -------------------------------------------------------

# Cron-udtryk: hvornår botten kører (standard: hver dag kl. 08:00)
# Se https://crontab.guru for hjælp
CRON_SCHEDULE=0 8 * * *

# Maksimalt antal gentagelser pr. ordre, inden vi giver op
MAX_RETRIES_PER_ORDER=10

# Millisekunder der ventes efter login / side-load
PAGE_TIMEOUT_MS=30000

# Kør botten én gang med det samme ved opstart (true/false)
RUN_ON_STARTUP=true

# -------------------------------------------------------
# Email-rapport (Resend)
# -------------------------------------------------------

# API-nøgle fra https://resend.com/api-keys
RESEND_API_KEY=

# Afsender-adresse (skal være verificeret domæne i Resend)
RESEND_FROM=bot@sebastiandrumm.dk

# Modtager
RESEND_TO=info@kloakgods.dk

# Vis browser-vindue under kørsel (true = synlig, false = headless)
HEADLESS=false

# -------------------------------------------------------
# Logging
# -------------------------------------------------------

# Log-niveau: error | warn | info | debug
LOG_LEVEL=info

# Mappe til log-filer (oprettes automatisk)
LOG_DIR=./logs
