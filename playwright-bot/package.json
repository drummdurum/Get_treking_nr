{
  "name": "kloakgods-tracking-bot",
  "version": "1.0.0",
  "description": "Playwright bot: henter Track & Trace fra AO/Ahlsell og opdaterer WooCommerce",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:wp-fulfillment": "node dist/wordpress/update-fulfillment.js",
    "dev": "ts-node src/index.ts",
    "run-once": "ts-node src/index.ts --once",
    "debug:wp": "ts-node src/debug-wordpress-auth.ts",
    "wp:fulfillment": "ts-node src/wordpress/update-fulfillment.ts",
    "bd:test": "ts-node src/BD_SGDD/test-order.ts",
    "provider:test": "ts-node src/test-provider.ts",
    "test": "npm run test:tracking",
    "test:tracking": "ts-node tests/tracking-utils.test.ts"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "playwright": "^1.44.1",
    "resend": "^6.12.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
